# ============================================================
# 绿电管家 · 环境变量模板
# 用法：复制本文件为 .env，再填入真实的 API Key
#   copy .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会被提交；本模板中不要写真实密钥
# ============================================================

# 智谱 API Key（必填，注册地址 https://bigmodel.cn/，GLM-4-Flash 长期免费）
DASHSCOPE_API_KEY=your-zhipu-key-here

# 智谱 OpenAI 兼容接口地址
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 主 Agent 使用的模型（glm-4-air 推荐，0.001元/千token；glm-4-flash 免费）
LLM_MODEL=glm-4-air

# 子代理使用的模型（可选，留空则与主 Agent 相同）
SUBAGENT_MODEL=

# 采样温度（可选）
LLM_TEMPERATURE=0.3

# MCP 配置文件（可选，默认 mcp_servers.json）
MCP_CONFIG=mcp_servers.json
