# ============================================================
# 绿电管家 · 环境变量模板
# 用法：复制本文件为 .env，再填入真实的 API Key
#   copy .env.example .env
# 用记事本打开 .env，把 DASHSCOPE_API_KEY= 后面换成你的阿里百炼 Key，保存
# 注意：.env 已被 .gitignore 忽略，不会被提交；本模板中不要写真实密钥
# ============================================================

# 阿里百炼 API Key（必填，注册地址 https://bailian.console.aliyun.com/）
DASHSCOPE_API_KEY=sk-your-key-here

# 阿里百炼 OpenAI 兼容接口地址（公网地址，必填）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主 Agent 使用的模型（可选，默认 qwen-plus）
# 可选：qwen-plus（推荐）/ qwen-turbo（快）/ qwen-max / deepseek-v3 / glm-4 / kimi-k2 ...
LLM_MODEL=qwen-plus

# 子代理使用的模型（可选，留空则与主 Agent 相同；可以换成更快更便宜的模型）
SUBAGENT_MODEL=

# 采样温度（可选）
LLM_TEMPERATURE=0.3

# MCP 配置文件（可选，默认 mcp_servers.json）
MCP_CONFIG=mcp_servers.json